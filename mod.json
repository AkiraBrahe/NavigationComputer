{
  "Name": "NavigationComputer",
  "Enabled": true,
  "Version": "2.4.0-BEX",

  "Description": "Adds system search, map modes, and custom routes into the game.",
  "Author": "mpstark, kierk",
  "Website": "https://github.com/AkiraBrahe/NavigationComputer",

  "DependsOn": [ "BT_Extended_Timeline" ],
